# 复制为 .env 并填写。密钥只在环境变量,绝不提交。
# 四槽位:creative(写作/规划)、review(红队/评审)、judge(裁判,须与 creative 不同模型族)、extract(抽取/摘要)
# provider 可选:mock | openai_compat | anthropic

NOVEL_CREATIVE__PROVIDER=mock
NOVEL_CREATIVE__MODEL=mock-model
#NOVEL_CREATIVE__FAMILY=claude
#NOVEL_CREATIVE__API_KEY=
#NOVEL_CREATIVE__BASE_URL=
# 未知型号运行 smoke-m26 时必须同时显式配置两项价格
#NOVEL_CREATIVE__INPUT_PRICE_USD_PER_MILLION=
#NOVEL_CREATIVE__OUTPUT_PRICE_USD_PER_MILLION=

NOVEL_REVIEW__PROVIDER=mock
NOVEL_REVIEW__MODEL=mock-model
#NOVEL_REVIEW__FAMILY=claude
#NOVEL_REVIEW__API_KEY=
#NOVEL_REVIEW__BASE_URL=
#NOVEL_REVIEW__INPUT_PRICE_USD_PER_MILLION=
#NOVEL_REVIEW__OUTPUT_PRICE_USD_PER_MILLION=

NOVEL_JUDGE__PROVIDER=mock
NOVEL_JUDGE__MODEL=mock-model
#NOVEL_JUDGE__FAMILY=gpt
#NOVEL_JUDGE__API_KEY=
#NOVEL_JUDGE__BASE_URL=
#NOVEL_JUDGE__INPUT_PRICE_USD_PER_MILLION=
#NOVEL_JUDGE__OUTPUT_PRICE_USD_PER_MILLION=

NOVEL_EXTRACT__PROVIDER=mock
NOVEL_EXTRACT__MODEL=mock-model
#NOVEL_EXTRACT__FAMILY=gpt
#NOVEL_EXTRACT__API_KEY=
#NOVEL_EXTRACT__BASE_URL=
#NOVEL_EXTRACT__INPUT_PRICE_USD_PER_MILLION=
#NOVEL_EXTRACT__OUTPUT_PRICE_USD_PER_MILLION=

NOVEL_DB_PATH=data/novel.db
NOVEL_MAX_CALLS_PER_CHAPTER=25
NOVEL_DEBUG_LOG=0
